GEMINI_MASTER_KEY=
AI_ENCRYPTION_KEY=
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=
FIREBASE_SERVICE_ACCOUNT=
VITE_FIRESTORE_DATABASE_ID=
FIREBASE_STORAGE_BUCKET=
GEMINI_TEXT_MODEL=gemini-3-flash-preview
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview

# New starter grants per UTC day; 0 pauses new grants without blocking existing accounts.
STARTER_DAILY_LIMIT=25

# Stripe: exact recurring price 49.00 PLN / month, inclusive of applicable tax.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PORTAL_CONFIGURATION_ID=
# Stable random secret, at least 32 chars; changing it breaks duplicate-card detection.
STRIPE_FINGERPRINT_SECRET=
# Public HTTPS origin, no trailing slash. Local test may use http://localhost:3187.
APP_URL=
